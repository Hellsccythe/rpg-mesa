{
  "name": "rpg-mesa-server",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Server-side logic for RPG Mesa",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
